# ─── Database ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5555
DB_NAME=hr_saas_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ─── JWT ─────────────────────────────────────────────────
# Generate a strong Base64-encoded secret (min 32 chars)
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION=86400000

# ─── Admin credentials file path ─────────────────────────
# Where the auto-generated admin password is written on each server restart
ADMIN_CREDENTIALS_FILE=./admin_credentials.txt

# ─── Server ──────────────────────────────────────────────
SERVER_PORT=8080
